# Git LFS for design (and common) binaries — requires git-lfs installed
# https://git-lfs.com
design/**/*.png filter=lfs diff=lfs merge=lfs -text
design/**/*.jpg filter=lfs diff=lfs merge=lfs -text
design/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
design/**/*.webp filter=lfs diff=lfs merge=lfs -text
design/**/*.gif filter=lfs diff=lfs merge=lfs -text
design/**/*.psd filter=lfs diff=lfs merge=lfs -text
design/**/*.sketch filter=lfs diff=lfs merge=lfs -text

# Optional: also track large GTM screenshots
gtm/**/*.png filter=lfs diff=lfs merge=lfs -text
gtm/**/*.jpg filter=lfs diff=lfs merge=lfs -text
gtm/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
gtm/**/*.webp filter=lfs diff=lfs merge=lfs -text
